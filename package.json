{
	"name": "@justland/vscode-extensions",
	"private": true,
	"type": "module",
	"description": "VS Code extensions developed by justland",
	"repository": {
		"type": "git",
		"url": "https://github.com/justland/vscode-extensions.git"
	},
	"license": "MIT",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "husky",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "turbo run build typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22"
	}
}
