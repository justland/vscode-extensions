{
	"name": "vscode-just-func",
	"displayName": "just-func",
	"version": "0.0.1",
	"private": true,
	"description": "Syntax highlighting for the just-func language",
	"categories": [
		"Programming Languages"
	],
	"scripts": {
		"build": "echo no build step",
		"clean": "echo no clean step",
		"test": "echo no test",
		"typecheck": "echo no typescript"
	},
	"contributes": {
		"grammars": [
			{
				"language": "just-func",
				"scopeName": "text.just-func",
				"path": "./syntaxes/just-func.tmLanguage.json"
			}
		],
		"languages": [
			{
				"id": "just-func",
				"aliases": [
					"just-func"
				],
				"extensions": [
					".jf"
				],
				"configuration": "./language-configuration.json"
			}
		]
	},
	"engines": {
		"vscode": "^1.134.0"
	}
}
