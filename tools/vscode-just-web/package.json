{
	"name": "vscode-just-web",
	"displayName": "just-web",
	"version": "0.0.1",
	"private": true,
	"description": "VS Code support for just-web applications",
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"scripts": {
		"build": "tsc -p ./",
		"build:watch": "tsc -w -p ./",
		"clean": "rimraf out .vscode-test",
		"test": "node ./out/test/runTest.js",
		"typecheck": "tsc -p ./ --noEmit"
	},
	"contributes": {
		"commands": [
			{
				"command": "vscode-just-web.helloWorld",
				"title": "Hello World"
			}
		]
	},
	"activationEvents": [],
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.13.3",
		"@types/vscode": "^1.134.0",
		"@vscode/test-electron": "^3.1.0",
		"mocha": "^11.8.0",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	},
	"engines": {
		"vscode": "^1.134.0"
	}
}
